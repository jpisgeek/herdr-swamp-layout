{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.12"
  },
  "type": "row",
  "theme": {
    "light": "paper",
    "dark": "swamp-club"
  },
  "ui_font": "Chakra Petch",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            },
            {
              "id": "swamp",
              "type": "column",
              "size": {
                "px": 400
              },
              "min": 300,
              "max": 700,
              "gap": 8,
              "children": [
                {
                  "id": "swamp-approvals",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 110,
                  "content": {
                    "mod": "swamp-approvals"
                  },
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "background": "chrome"
                },
                {
                  "id": "swamp-tools",
                  "type": "stack",
                  "size": {
                    "weight": 3
                  },
                  "min": 200,
                  "active": "swamp-runs",
                  "header": {
                    "content": {
                      "mod": "swamp-tabs",
                      "props": {
                        "stack": "swamp-tools"
                      }
                    },
                    "height": 36
                  },
                  "children": [
                    {
                      "id": "swamp-runs",
                      "type": "block",
                      "content": {
                        "mod": "swamp-runs"
                      }
                    },
                    {
                      "id": "swamp-quickrun",
                      "type": "block",
                      "content": {
                        "mod": "swamp-quickrun"
                      }
                    }
                  ],
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "background": "chrome"
                }
              ]
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-row",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "swamp-status",
              "type": "block",
              "size": {
                "px": 380
              },
              "content": {
                "mod": "swamp-status"
              }
            }
          ]
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/swamp.svg"
}
